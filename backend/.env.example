# Copy this file to .env and use the same PostgreSQL database as the forex terminal.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=itr_market_data
PGUSER=orderflow_app
PGPASSWORD=replace_with_your_postgres_password
# Shared market symbol used when loading the database in the replay UI.
MARKET_SYMBOL=XAUUSD
PORT=4001
# Large tick/bar JSON payloads can exceed Express' default/small limits
JSON_LIMIT=100mb
# Comma-separated list of allowed origins (your site)
CORS_ORIGIN=https://gestagsm.github.io,https://iibshe.com,http://iibshe.com,http://localhost:8080,http://127.0.0.1:8080

# ==== Folder Watcher (auto-ingest TAQ/TAS/GCV files into PostgreSQL) ====
# Absolute path to the folder the other platform drops TAQ/TAS/GCV files into.
# Leave empty/unset to disable the watcher entirely.
WATCH_DIR=C:\path\to\incoming-files
# Optional historical source folder scanned alongside WATCH_DIR.
# Relative paths are resolved from the backend working directory.
WATCH_HISTORY_DIR=
# Successfully imported source files are moved into this persistent archive.
# Relative paths are resolved from the backend working directory.
WATCH_ARCHIVE_DIR=.\data\market-files
# Poll shared ITR Terminal ticks into project CSV snapshots, in milliseconds.
WATCH_DB_EXPORT_POLL_MS=5000
# Rows per database export batch (larger batches reduce the number of output files).
WATCH_DB_EXPORT_BATCH_SIZE=10000
# How often to check the folder, in milliseconds (1000 = every second)
WATCH_POLL_MS=1000
# Filename patterns (case-insensitive) used to tell TAQ/TAS/GCV files apart
WATCH_GCV_PATTERN=GCV
WATCH_TAQ_PATTERN=TAQ
WATCH_TAS_PATTERN=TAS
# Failed files are quarantined in this subfolder under the source directory.
WATCH_FAILED_DIRNAME=_failed
