<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="RealTime Terminal API HTTPS alias" stopProcessing="true">
          <match url="^terminal-api/api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4001/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="OrderFlow API Reverse Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4001/api/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>